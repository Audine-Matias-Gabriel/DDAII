# --- Base de datos (backend local) ---
DB_URL=jdbc:postgresql://localhost:5432/tienda
DB_USER=tienda
DB_PASSWORD=tienda

# --- RabbitMQ ---
RABBIT_URI_HOST=localhost
RABBIT_URI_PORT=5672
RABBIT_URI_USERNAME=guest
RABBIT_URI_PASSWORD=guest
RABBIT_EXCHANGE=tienda.exchange
RABBIT_QUEUE_PRODUCTO_SCRAPEADO=producto.scrapeado.queue
RABBIT_QUEUE_PRODUCTO_SCRAPEADO_DLQ=producto.scrapeado.dlq
RABBIT_QUEUE_SUSCRIPCION_ACTIVADA=suscripcion.activada.queue
RABBIT_QUEUE_SUSCRIPCION_ACTIVADA_DLQ=suscripcion.activada.dlq
RABBIT_QUEUE_RECOMENDACION_SOLICITADA=recomendacion.solicitada.queue
RABBIT_QUEUE_RECOMENDACION_SOLICITADA_DLQ=recomendacion.solicitada.dlq

# --- Mercado Pago (sandbox) ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_BASE_URL=https://api.mercadopago.com
# Webhook (opcional, ver docs/pagos.md): URL https pública del backend (ej. la de "ngrok http 8080")
MP_NOTIFICATION_BASE_URL=
# Clave secreta del webhook (Tus integraciones → Webhooks) para validar x-signature
MP_WEBHOOK_SECRET=

# --- Ximilar (backend Java) ---
# Token y colección de tu cuenta de Ximilar (app.ximilar.com → Settings). NO subir el token al repo: va solo en .env
XIMILAR_API_KEY=
XIMILAR_COLLECTION_ID=
XIMILAR_BASE_URL=https://api.ximilar.com
# Poner en true para usar mock y no consumir créditos reales
XIMILAR_MOCK=false
# Sube solas las imágenes nuevas a la colección cada 10 minutos (0,25 créditos por imagen)
XIMILAR_INDEXADO_AUTOMATICO=true
# Topes para no pasarse del plan gratuito (1.000 créditos/mes, colección de 1.000 registros)
XIMILAR_MAXIMO_POR_CORRIDA=100
XIMILAR_MAXIMO_COLECCION=1000

# --- Ximilar (servicio Node tienda/ximilar-product-similarity) ---
XIMILAR_API_TOKEN=

# --- Scraper (Node, tienda/scraper) ---
# Claves de tienda/scraper/src/config/tiendas.js; vacío = todas las activas
TIENDAS=SPORTLINE,GRID,NEWSPORT
SCHEDULER_CRON=0 2 * * *
MAX_PRODUCTS=300
PAGE_SIZE=50
REQUEST_DELAY_MS=700

# --- Puertos / CORS ---
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173

# A donde vuelve el comprador desde Mercado Pago (/pago/exito y /pago/error)
FRONTEND_URL=http://localhost:5173
# Precio del plan premium en pesos argentinos
MP_PREMIUM_PRECIO=5000
