# ==== Scraper WebDeRopa ====
# Copiar a .env para correrlo fuera de Docker (npm run scrape / npm run scheduler:now).

# Tiendas que corren (claves de src/config/tiendas.js). Vacío = todas las activas.
TIENDAS=SPORTLINE,GRID

# RabbitMQ. Si no hay RABBITMQ_URL se arma con RABBIT_URI_HOST/PORT/USERNAME/PASSWORD.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=tienda.exchange

# Límites por tienda
MAX_PRODUCTS=100
PAGE_SIZE=50
REQUEST_DELAY_MS=700

# Scheduler (todos los días a las 2:00)
SCHEDULER_CRON=0 2 * * *
SCHEDULER_TIMEZONE=America/Argentina/Buenos_Aires
