# ==== Scraper KNOWFIT - configuración multi-tienda ====

# Tienda a ejecutar con `npm run scrape` (SPORTLINE | LASMARGARITAS)
STORE_ADAPTER=SPORTLINE

# ----- Sportline (VTEX) -----
SPORTLINE_STORE_ID=1
SPORTLINE_STORE_NAME=Sportline
SPORTLINE_STORE_URL=https://www.sportline.com.ar
SPORTLINE_VTEX_SEARCH_URL=https://www.sportline.com.ar/api/catalog_system/pub/products/search
SPORTLINE_EVENT_NAME=Sportline
SPORTLINE_OUTPUT_FILE=output/sportline.json

# ----- Las Margaritas (VTEX) -----
LASMARGARITAS_STORE_ID=2
LASMARGARITAS_STORE_NAME=Las Margaritas
LASMARGARITAS_STORE_URL=https://www.lasmargaritas.com.ar
LASMARGARITAS_VTEX_SEARCH_URL=https://www.lasmargaritas.com.ar/api/catalog_system/pub/products/search
LASMARGARITAS_EVENT_NAME=Las Margaritas
LASMARGARITAS_OUTPUT_FILE=output/lasmargaritas.json

# ----- Parámetros comunes de scraping -----
PAGE_SIZE=50
MAX_PRODUCTS=150
REQUEST_DELAY_MS=700

# ----- RabbitMQ (exchange compartido por todas las tiendas) -----
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=knowfit.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_KEY=producto.scrapeado

# ----- Scheduler -----
STORES=SPORTLINE,LASMARGARITAS
SCHEDULER_CRON=0 2 * * *
SCHEDULER_TIMEZONE=America/Argentina/Buenos_Aires