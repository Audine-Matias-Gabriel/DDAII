# Estrategia que se ejecutará. Actualmente: SPORTLINE
STORE_ADAPTER=SPORTLINE

# Identidad de la tienda que se asigna a los productos
STORE_ID=1
STORE_NAME=Sportline
STORE_URL=https://www.sportline.com.ar

# Configuración VTEX de Sportline
VTEX_SEARCH_URL=https://www.sportline.com.ar/api/catalog_system/pub/products/search
PAGE_SIZE=50
MAX_PRODUCTS=150
REQUEST_DELAY_MS=700

# Archivo de salida
OUTPUT_FILE=output/sportline.json
