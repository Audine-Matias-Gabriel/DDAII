{
  "name": "knowfit-scraper",
  "version": "1.0.0",
  "description": "Extractor y normalizador multi-tienda del catálogo KNOWFIT",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "scrape": "node src/index.js",
    "scrape:sportline": "node src/index.js --store=SPORTLINE",
