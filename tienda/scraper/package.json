  "description": "Scraper multi-tienda del catálogo de WebDeRopa: extrae, normaliza y publica ProductoScrapeado en RabbitMQ",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
